{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": "9b06b7bf-4485-4308-b82f-a2a28fa05888",
    "schematicCollections": ["angular-eslint", "playwright-ng-schematics"]
  },
  "newProjectRoot": "projects",
  "projects": {
    "nexora": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-builders/custom-esbuild:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": ["src/styles.scss"],
            "stylePreprocessorOptions": {
              "includePaths": ["src/styles"]
            },
            "plugins": ["./esbuild.plugins.ts"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "server": "src/main.server.ts",
              "outputMode": "static"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-builders/custom-esbuild:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "nexora:build:production"
            },
            "development": {
              "buildTarget": "nexora:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "prebundle": {
              "exclude": ["intlayer", "angular-intlayer", "@intlayer/config", "@intlayer/core"]
            }
          }
        },
        "test": {
          "builder": "@angular-builders/custom-esbuild:unit-test",
          "options": {
            "buildTarget": "nexora:build:development",
            "tsConfig": "tsconfig.spec.json"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["src/**/*.ts", "src/**/*.html", "e2e/**/*.ts"]
          }
        },
        "e2e": {
          "builder": "playwright-ng-schematics:playwright",
          "options": {
            "devServerTarget": "nexora:serve",
            "port": 4300
          },
          "configurations": {
            "production": {
              "devServerTarget": "nexora:serve:production"
            }
          }
        }
      }
    }
  }
}
