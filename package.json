{
  "name": "nexora",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/intlayer-lock.mjs ng serve",
    "build": "node scripts/intlayer-lock.mjs ng build",
    "watch": "node scripts/intlayer-lock.mjs ng build --watch --configuration development",
    "test": "node scripts/intlayer-lock.mjs ng test",
    "e2e": "node scripts/intlayer-lock.mjs ng e2e",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p e2e/tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "lint": "ng lint && npm run lint:deps && npm run lint:styles",
    "lint:deps": "depcruise src/app --config .dependency-cruiser.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "lint:styles": "stylelint \"src/**/*.scss\""
  },
  "private": true,
  "packageManager": "npm@12.2.0",
  "dependencies": {
    "@angular/cdk": "^22.2.3",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/material": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/ssr": "^22.2.4",
    "angular-intlayer": "^9.7.0",
    "intlayer": "^9.7.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-builders/custom-esbuild": "^22.0.1",
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@angular/platform-server": "^22.2.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "angular-eslint": "22.6.0",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.12.0",
    "jsdom": "^28.0.0",
    "playwright-ng-schematics": "^22.1.2",
    "prettier": "^3.8.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "8.71.0",
    "vitest": "^4.0.8"
  }
}
